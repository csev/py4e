{
    "name": "csev/py4e",
    "description": "Python for Everybody",
    "require": {
        "php": ">=8.4.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0"
    },
    "scripts": {
        "phpstan": "phpstan analyse -c phpstan.neon --memory-limit=1G --no-progress"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    }
}
