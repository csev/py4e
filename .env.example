# Copy to .env and adjust.  ->  cp .env.example .env
#
# ---- Public URL --------------------------------------------------------------
# Localhost:
PY4E_APPHOME=http://localhost:8080
# On a VPS / Dokploy, use your real domain (https):
# PY4E_APPHOME=https://py4e.example.com
#
# PY4E_WWWROOT defaults to ${PY4E_APPHOME}/tsugi — only set it if you serve
# tsugi from a different path.
# PY4E_WWWROOT=

# Host port to publish on localhost (left side of the ports mapping).
PY4E_HTTP_PORT=8080

# Where Tsugi's static assets (bootstrap, jquery, css, ...) are served from.
# These are NOT bundled in the tsugi repo — the default is the Tsugi CDN.
# Point this at a self-hosted copy of the tsugi-static repo to avoid the CDN.
PY4E_STATICROOT=https://static.tsugi.org

# ---- Tsugi admin console password -------------------------------------------
PY4E_ADMIN_PW=change-me

# ---- Database (used by both the web app and the mysql container) -------------
MYSQL_DATABASE=tsugi
MYSQL_USER=ltiuser
MYSQL_PASSWORD=change-me-too
MYSQL_ROOT_PASSWORD=change-me-root

# ---- Which Tsugi version to build -------------------------------------------
TSUGI_REF=master

# ---- Optional: Google login + Maps (leave blank to disable) ------------------
PY4E_GOOGLE_CLIENT_ID=
PY4E_GOOGLE_CLIENT_SECRET=
PY4E_GOOGLE_MAP_API_KEY=
