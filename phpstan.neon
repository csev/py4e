# Static analysis for PHP 8.4 and 8.5. No web server is involved.
# Tsugi is scanned for symbols only; its own code is not reported.
# Locally, the gitignored tsugi/ checkout must be present.
# Run: composer phpstan
includes:
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    level: 3
    phpVersion:
        min: 80400   # PHP 8.4
        max: 80500   # PHP 8.5
    stubFiles:
        - phpstan-stubs.php
    scanFiles:
        - phpstan-stubs.php
        - tsugi/lib/include/setup.php
        - tsugi/lib/include/setup_i18n.php
        # setup.php loads this through a variable path. It defines startsWith().
        - tsugi/lib/include/lms_lib.php
        # Vendored library. Scanned for the Parsedown class, not reported.
        - vscode/Parsedown.php
    scanDirectories:
        - tsugi/lib/src
        - tsugi/koseu/src
    paths:
        - index.php
        - nav.php
        - buildmenu.php
        - top.php
        - footer.php
        - privacy.php
        - launcherror.php
        - coursesredirect.php
        - tsugi_settings.php
        - tsugi.php
        - support.php
        - sanity.php
        - install.php
        - materials.php
        - others.php
        - book.php
        - book2.php
        - booktop.php
        - bookfoot.php
        - editors.php
        - service.php
        - software-mac.php
        - software-win.php
        - software-replit.php
        - software-pyaw.php
        - cron
        - html3
        - tools
        - site-ai
        - site-labs
        - lectures
        - lectures3
        - podcasts
        - code
        - code2
        - code3
        - vscode
        - mod/index.php
        - mod/config.php
    excludePaths:
        # Vendored Parsedown 1.6. Its new static() factory is library code.
        - vscode/Parsedown.php
    reportUnmatchedIgnoredErrors: true
    checkMaybeUndefinedVariables: false
    # Tsugi still ships these APIs. They are deprecated inside Tsugi, not by PHP.
    ignoreErrors:
        -
            message: '#deprecated class Tsugi\\Core\\Settings#'
        -
            message: '#deprecated method ltiCustomGet\(\)#'
